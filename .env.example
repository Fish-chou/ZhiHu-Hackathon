# 复制为 .env.local 后填写。所有变量只在服务端读取，不要加 NEXT_PUBLIC_ 前缀。

# Supabase 项目地址与 publishable（anon）key。不要使用 service_role / secret key。
# 不填时网站进入“离线证据快照”模式，只读取 src/data/evidence-snapshot.json。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# OpenAI 兼容的大模型接口。不填时审查结果降级为“规则匹配结果”，演示案例显示缓存结果。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 可选
# LLM_TIMEOUT_MS=40000
# AUDIT_RATE_LIMIT=10        # 每个 IP 每分钟最多实时审查次数
# AUDIT_LOG_DISABLED=1       # 不写 analysis_runs / findings
